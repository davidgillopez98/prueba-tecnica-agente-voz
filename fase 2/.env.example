# Demo y tests no necesitan credenciales. Solo el canal de voz interactivo
# opcional usa los proveedores siguientes (no utilizar datos reales).
deepgram__api_key=xxxxxxxx

# Modelo y endpoint local de Ollama
llm__model=gemma4:e2b
llm__endpoint=localhost:11434/api

# Nivel de logs: DEBUG, INFO, WARNING o ERROR
log_level=INFO

# Expedientes sinteticos locales; archivo excluido de Git
claims_db_path=claims.sqlite3
